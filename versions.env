# Pinned commits of the patched forks that install.sh builds.
# To ship a new patch: merge it into the fork's henn/main, push, put the new
# commit here, commit this file, and run ./install.sh.

# wlroots 0.20.2 + henn patches (henn/main)
WLROOTS_REPO=https://github.com/henn-dotfiles/wlroots.git
WLROOTS_REF=5f895181f680bc0a26445157edfd87627c1b715f

# labwc 0.20.3 + henn patches (henn/main), linked to the wlroots above
LABWC_REPO=https://github.com/henn-dotfiles/labwc.git
LABWC_REF=4d00ed3c23711e3d41f0bdd38c388e326de40427

# DMS (dux-shell) v2.1.0 + henn patches (henn/main). The dms binary is built
# from it with the patched QML shell embedded; it replaces /usr/bin/dms.
DMS_REPO=https://github.com/henn-dotfiles/dux-shell.git
DMS_REF=58946f6fdd4f085d04fb13ab2bd756971bb8e788
